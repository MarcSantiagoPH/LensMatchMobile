<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgPrimary"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="40dp"
        android:gravity="center_horizontal">

        <!-- Page title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analysis Result"
            android:textColor="@color/textPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="24dp" />

        <!-- Face Photo Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="130dp"
            android:layout_height="160dp"
            app:cardBackgroundColor="@color/bgCard"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/borderCard"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/iv_face_crop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_user" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Shape + Confidence -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_detected_shape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oval"
                android:textColor="@color/accentGold"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_confidence_match"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_confidence_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="94% Match"
                android:textColor="@color/accentGold"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Borderline / Calibration Notice Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_borderline_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#1AFFB300"
            app:cardCornerRadius="14dp"
            app:strokeColor="#66FFB300"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_help"
                    app:tint="#FFB300"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tv_borderline_notes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Borderline Result: Your facial features sit between Oval and Round."
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AI Stylist Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_ai_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#0FD4AF37"
            app:cardCornerRadius="16dp"
            app:strokeColor="#33D4AF37"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_eyeglasses"
                        app:tint="@color/accentGold"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Eyewear Stylist"
                        android:textColor="@color/accentGold"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_ai_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Based on your face shape, these frames will complement your features perfectly."
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recommended Frames -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="RECOMMENDED"
            android:textColor="@color/textSecondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_recommended"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacing="6dp" />

        <!-- Frames to avoid -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="AVOID"
            android:textColor="@color/textSecondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_avoided"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacing="6dp" />

        <!-- CTA Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_try_frames_on"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:text="Try Frames On"
            android:textColor="@color/bgCard"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            app:backgroundTint="@color/accentGold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_eyeglasses"
            app:iconTint="@color/bgCard"
            app:iconGravity="textStart"
            app:iconPadding="10dp" />

    </LinearLayout>
</ScrollView>
