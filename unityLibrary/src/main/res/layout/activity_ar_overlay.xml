<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- ═══════════════════════ TOP BAR ═══════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <!-- Back Button — circular frosted pill -->
        <ImageView
            android:id="@+id/btn_back_unity_ar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_ar_back_btn"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_left" />

        <!-- Screen title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Try Frames On"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04" />

        <!-- Spacer to balance the back button -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />

    </LinearLayout>

    <!-- ═══════════════════════ BOTTOM PANEL ═══════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_ar_bottom_panel"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="32dp">

        <!-- Drag handle pill -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="#44FFFFFF"
            android:backgroundTint="@null" />

        <!-- Section label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="4dp"
            android:text="FRAME STYLE"
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:fontFamily="sans-serif-medium" />

        <!-- ─── TABS: Recommended | All Frames ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- Recommended tab -->
            <LinearLayout
                android:id="@+id/tab_recommended_unity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tv_tab_recommended_unity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recommended"
                    android:textColor="@color/accentGold"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <View
                    android:id="@+id/indicator_recommended_unity"
                    android:layout_width="80dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_tab_indicator_gold" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:background="#22FFFFFF" />

            <!-- All Frames tab -->
            <LinearLayout
                android:id="@+id/tab_all_frames_unity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tv_tab_all_frames_unity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Frames"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />

                <View
                    android:id="@+id/indicator_all_frames_unity"
                    android:layout_width="80dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/transparent" />
            </LinearLayout>
        </LinearLayout>

        <!-- ─── FRAME CIRCLES (scrollable) ─── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="horizontal">

            <LinearLayout
                android:id="@+id/layout_frames_unity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="4dp" />
        </HorizontalScrollView>

        <!-- ─── DIVIDER ─── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="#1AFFFFFF" />

        <!-- ─── COLOR VARIATIONS SECTION ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COLOR"
                android:textColor="#66FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="12dp" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="horizontal">

                <LinearLayout
                    android:id="@+id/layout_colors_unity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp" />
            </HorizontalScrollView>
        </LinearLayout>

    </LinearLayout>

    <!-- ═══════════════════════ LOADING OVERLAY ═══════════════════════ -->
    <!-- Visible while Unity engine initializes. Hidden by onUnityReady() or 800ms timer. -->
    <FrameLayout
        android:id="@+id/unity_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:indeterminateTint="#D4AF37"
                style="?android:attr/progressBarStyle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Loading AR..."
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:letterSpacing="0.06"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
