<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/landing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3B5B8A"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Architectural Ambient Disc matching mockup -->
    <View
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-150dp"
        android:background="@drawable/bg_landing_top_disc" />

    <LinearLayout
        android:id="@+id/landing_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <!-- Center Section: Animated Logo & Hero Branding -->
        <LinearLayout
            android:id="@+id/layout_hero_center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Official LensMatch Logo Seamless Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_logo_container"
                android:layout_width="160dp"
                android:layout_height="160dp"
                app:cardCornerRadius="36dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#3B5B8A"
                app:strokeColor="#F28B30"
                app:strokeWidth="2.5dp">

                <ImageView
                    android:id="@+id/iv_landing_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="LensMatch Logo"
                    android:src="@drawable/logo_lensmatch" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Brand Title in Sunkissed Orange -->
            <TextView
                android:id="@+id/tv_landing_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="LensMatch"
                android:textColor="#F28B30"
                android:textSize="38sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:fontFamily="sans-serif-medium" />

            <!-- Tagline in Crisp White -->
            <TextView
                android:id="@+id/tv_landing_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Find Your Perfect Frame"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_landing_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="AI-powered face analysis &amp; real-time 3D AR virtual try-on tailored to you."
                android:textColor="#D5E2F1"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="16dp" />

            <!-- Highlight Feature Badges with rounded corners -->
            <LinearLayout
                android:id="@+id/layout_feature_badges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Analysis"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_landing_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="3D AR Try-On"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_landing_pill_active"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Virtual Catalog"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_landing_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Interactive Gesture Area -->
        <LinearLayout
            android:id="@+id/layout_bottom_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="24dp">

            <!-- Animated Swipe / Tap Prompt -->
            <LinearLayout
                android:id="@+id/layout_swipe_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:id="@+id/iv_swipe_chevron"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_chevron_up"
                    app:tint="#F28B30" />

                <TextView
                    android:id="@+id/tv_swipe_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Swipe up or tap to begin"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>