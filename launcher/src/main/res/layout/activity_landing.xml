<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/landing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF8C00"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Ambient Disc (light orange blended circle) -->
    <View
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-150dp"
        android:background="@drawable/bg_landing_top_disc" />

    <!-- Bottom ambient glow disc -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="-80dp"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/bg_landing_top_disc"
        android:alpha="0.35" />

    <LinearLayout
        android:id="@+id/landing_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <!-- Center Section: Animated Logo & Hero Branding -->
        <LinearLayout
            android:id="@+id/layout_hero_center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Official LensMatch Logo on White Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_logo_container"
                android:layout_width="170dp"
                android:layout_height="170dp"
                app:cardCornerRadius="40dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#FFB347"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/iv_landing_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="LensMatch Logo"
                    android:src="@drawable/logo_lensmatch" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Brand Title in White -->
            <TextView
                android:id="@+id/tv_landing_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="LensMatch"
                android:textColor="#FFFFFF"
                android:textSize="42sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:fontFamily="sans-serif-medium" />

            <!-- Tagline in semi-transparent white -->
            <TextView
                android:id="@+id/tv_landing_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Find Your Perfect Frame"
                android:textColor="#FFE5C0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_landing_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="AI-powered face analysis &amp; real-time 3D AR frame preview tailored to you."
                android:textColor="#FFEBCC"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="16dp" />

            <!-- Highlight Feature Badges -->
            <LinearLayout
                android:id="@+id/layout_feature_badges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Analysis"
                    android:textColor="#FF8C00"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_landing_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="3D Frame Preview"
                    android:textColor="#FF8C00"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_landing_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Virtual Catalog"
                    android:textColor="#FF8C00"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_landing_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Interactive Gesture Area -->
        <LinearLayout
            android:id="@+id/layout_bottom_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="24dp">

            <!-- Animated Swipe / Tap Prompt -->
            <LinearLayout
                android:id="@+id/layout_swipe_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:id="@+id/iv_swipe_chevron"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_up"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tv_swipe_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Swipe up or tap to begin"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>