<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scan_history_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_scan_history"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        app:navigationIcon="@drawable/ic_chevron_left"
        app:navigationIconTint="#1A1A1A"
        app:title="Scan History"
        app:titleTextColor="#1A1A1A" />

    <!-- Subtitle summary header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SAVED AI SCANS"
            android:textColor="#CC7700"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_scan_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textColor="#FF8C00"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Progress Loading -->
        <ProgressBar
            android:id="@+id/progress_scan_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#FF8C00"
            android:visibility="visible" />

        <!-- RecyclerView for multiple scans -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_scan_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:visibility="gone" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layout_empty_scan_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_avatar_circle"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_scan"
                    app:tint="#FF8C00" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Scan History Yet"
                android:textColor="#1A1A1A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Scan your face with our AI analyzer to get personalized frame recommendations. All scans will be securely saved here."
                android:textColor="#777777"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_empty_start_scan"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="📷   START AI FACE SCAN"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#FF8C00"
                app:cornerRadius="12dp"
                android:paddingHorizontal="24dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Sticky Button to take new scan -->
    <LinearLayout
        android:id="@+id/layout_bottom_scan_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan_again"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📷   TAKE NEW FACE SCAN"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:backgroundTint="#FF8C00"
            app:cornerRadius="12dp"
            app:elevation="2dp" />
    </LinearLayout>

</LinearLayout>
