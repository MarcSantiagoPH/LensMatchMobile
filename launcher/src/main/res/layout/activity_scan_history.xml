<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scan_history_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgPrimary"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_scan_history"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bgPrimary"
        app:navigationIcon="@drawable/ic_chevron_left"
        app:navigationIconTint="@color/white"
        app:title="Scan History"
        app:titleTextColor="@color/textPrimary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="40dp">

            <!-- Latest Scan Card Container -->
            <LinearLayout
                android:id="@+id/layout_scan_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recent Scans"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <!-- Scan History Item Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_latest_scan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#121212"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/borderCard"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@id/chip_scan_confidence">

                                <TextView
                                    android:id="@+id/tv_scan_shape_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Oval Face Shape"
                                    android:textColor="@color/textPrimary"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_scan_timestamp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Recent Scan • AI Analyzed"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="12sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/chip_scan_confidence"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_confidence_chip"
                                android:text="94% Match"
                                android:textColor="@color/accentGold"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp" />
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/tv_scan_recommendation_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Recommended Styles: Wayfarer, Round, Aviator"
                            android:textColor="@color/textSecondary"
                            android:textSize="13sp"
                            android:layout_marginBottom="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_scan_again"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Take New Face Scan"
                            android:textColor="@color/bgPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/accentGold"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Empty State (Shown when no scan has been recorded yet) -->
            <LinearLayout
                android:id="@+id/layout_empty_scan_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="64dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_scan"
                    app:tint="@color/accentGold"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Scan History Yet"
                    android:textColor="@color/textPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Analyze your face using our precision AI scanner to get personalized frame recommendations."
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:paddingHorizontal="32dp"
                    android:layout_marginBottom="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_start_scan"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="Start AI Face Scan"
                    android:textColor="@color/bgPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accentGold"
                    app:cornerRadius="14dp"
                    android:paddingHorizontal="32dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
