<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Feed -->
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Face Mesh Dots Overlay (no vignette, direct facial mesh dots) -->
    <com.lensmatch.mobile.ui.FaceMeshOverlayView
        android:id="@+id/face_mesh_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Left Close Button (X icon) -->
    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        android:contentDescription="Close" />

    <!-- Instruction Pill (center top) with glowing border -->
    <LinearLayout
        android:id="@+id/layout_instruction_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_instruction_pill_green"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tv_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Face Aligned! Ready to scan."
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Bottom Capture Button (Gold "Capture & Scan" button) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingHorizontal="24dp"
        android:paddingBottom="42dp"
        android:paddingTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_capture"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Capture &amp; Scan"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accentGold"
            app:cornerRadius="16dp" />

        <ProgressBar
            android:id="@+id/progress_capture"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/black"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>
