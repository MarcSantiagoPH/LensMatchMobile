rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // STAFF AUTHORIZATION HELPER
    // Evaluates to true if the authenticated user is an active staff member.
    // ==========================================
    function isStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/STAFF/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/STAFF/$(request.auth.uid)).data.role == "staff" &&
        get(/databases/$(database)/documents/STAFF/$(request.auth.uid)).data.isActive == true;
    }

    // ==========================================
    // STAFF COLLECTION
    // Staff users can read their own STAFF authorization document.
    // Writes and reading other staff documents are denied.
    // ==========================================
    match /STAFF/{staffId} {
      allow read: if request.auth != null && request.auth.uid == staffId;
      allow write: if false;
    }

    // ==========================================
    // CUSTOMERS COLLECTION
    // Customers can read, create, and update their own CUSTOMERS profile document.
    // Staff can read all customer records. Deletion and cross-customer access are denied.
    // ==========================================
    match /CUSTOMERS/{customerId} {
      allow read: if request.auth != null && (request.auth.uid == customerId || isStaff());
      allow create, update: if request.auth != null && request.auth.uid == customerId;
      allow delete: if false;
    }

    // ==========================================
    // PATIENT_RECORDS COLLECTION
    // Standalone digital clinical case files.
    // Accessible ONLY to active staff members. Customers and unauthenticated users are denied.
    // ==========================================
    match /PATIENT_RECORDS/{recordId} {
      allow read, create, update, delete: if isStaff();
    }

    // ==========================================
    // RESERVATIONS COLLECTION
    // Customer: Create own Pending reservation; read own reservations; cancel Pending reservation with required reason.
    // Staff: Read all reservations; update status according to transition-specific field restrictions.
    // ==========================================
    match /RESERVATIONS/{reservationId} {
      // READ: Customer reads own reservation; Staff reads all.
      allow read: if request.auth != null && (resource.data.customerId == request.auth.uid || isStaff());

      // CREATE: Customer creates their own reservation with initial status "Pending".
      // Allows standard customer fields (including customerPhone) while prohibiting staff-controlled fields.
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.keys().hasOnly([
          'customerId', 'customerName', 'customerEmail', 'customerPhone',
          'frameId', 'frameName', 'brand', 'frameStyle', 'price',
          'imageUrl', 'status', 'createdAt', 'statusUpdatedAt'
        ])
        && (!('statusUpdatedAt' in request.resource.data) || request.resource.data.statusUpdatedAt == null)
        && !request.resource.data.keys().hasAny(['reservationDeadline', 'rejectionReason', 'cancellationReason']);

      // UPDATE:
      // Customer: Cancel own Pending reservation (Pending -> Cancelled) with required non-empty cancellationReason.
      // Staff: Update status according to transition-specific field immutability and lifecycle rules.
      allow update: if (
        // 1. Customer Pending -> Cancelled (Evaluated FIRST so customer updates short-circuit without triggering isStaff())
        (request.auth != null
          && resource.data.customerId == request.auth.uid
          && resource.data.status == 'Pending'
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt', 'cancellationReason'])
          && 'cancellationReason' in request.resource.data
          && request.resource.data.cancellationReason is string
          && request.resource.data.cancellationReason.trim().size() > 0
          && request.resource.data.statusUpdatedAt is timestamp
        )
        ||
        // 2. Staff Pending -> Approved (Allowed changed fields ONLY: status, statusUpdatedAt, reservationDeadline)
        (isStaff()
          && resource.data.status == 'Pending'
          && request.resource.data.status == 'Approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt', 'reservationDeadline'])
          && request.resource.data.reservationDeadline is timestamp
          && request.resource.data.statusUpdatedAt is timestamp
        )
        ||
        // 3. Staff Pending -> Rejected (Allowed changed fields ONLY: status, statusUpdatedAt, rejectionReason)
        (isStaff()
          && resource.data.status == 'Pending'
          && request.resource.data.status == 'Rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt', 'rejectionReason'])
          && request.resource.data.rejectionReason is string
          && request.resource.data.rejectionReason.trim().size() > 0
          && request.resource.data.statusUpdatedAt is timestamp
        )
        ||
        // 4. Staff Approved -> Completed (Allowed changed fields ONLY: status, statusUpdatedAt)
        (isStaff()
          && resource.data.status == 'Approved'
          && request.resource.data.status == 'Completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt'])
          && request.resource.data.statusUpdatedAt is timestamp
        )
      );

      // DELETE: Denied for all users
      allow delete: if false;
    }

    // ==========================================
    // FRAME_CATALOG COLLECTION
    // Public read access for mobile app catalog browsing.
    // Full write access (create, update, delete) restricted to active staff.
    // ==========================================
    match /FRAME_CATALOG/{frameId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // ==========================================
    // CLINIC_INFORMATION COLLECTION
    // Public read access for clinic details and opening hours.
    // Write access restricted to active staff.
    // ==========================================
    match /CLINIC_INFORMATION/{docId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // ==========================================
    // ANNOUNCEMENTS COLLECTION
    // Public read access for mobile customer application browsing.
    // Full write access (create, update, delete) restricted to active staff.
    // ==========================================
    match /ANNOUNCEMENTS/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // ==========================================
    // SCAN_HISTORY COLLECTION
    // Enforces strict customer account isolation while permitting staff review.
    // ==========================================
    match /SCAN_HISTORY/{scanId} {
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid;

      allow read, update, delete: if request.auth != null
        && resource.data.customerId == request.auth.uid;

      allow read: if isStaff();
    }

    // ==========================================
    // OTP_VERIFICATIONS COLLECTION
    // Server-managed via Firebase Admin SDK only. Direct client SDK access denied.
    // ==========================================
    match /OTP_VERIFICATIONS/{docId} {
      allow read, write: if false;
    }
  }
}
